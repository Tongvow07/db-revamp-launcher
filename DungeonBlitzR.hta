<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<title>DB Revamped</title>
<hta:application id="app" applicationname="DB Revamped" border="thin" borderstyle="complex"
    caption="yes" contextmenu="no" innerborder="no" maximizebutton="no" minimizebutton="yes"
    scroll="no" selection="no" showintaskbar="yes" singleinstance="yes" sysmenu="yes" />
<style>html,body{height:100%;margin:0;background:#070707;overflow:hidden;font-family:Georgia,serif;color:#f8f2ea}
#boot{position:absolute;top:50%;left:0;right:0;transform:translateY(-50%);text-align:center;font-size:13px;color:#a99a86}</style>
</head>
<body>
<div id="root"><div id="boot">Loading DB Revamped…</div></div>
<script language="JScript">
/* Thin, stable shell. The real UI lives in ui.js on the server, so updates reach every
   player automatically with no re-download. A local copy under launcher-assets/ is the
   offline fallback. The shell never needs changing. */
var HOST="https://dungeonblitzv.duckdns.org";
var UI_URL=HOST+"/launcher/ui.js";
function newXhr(){ try{return new ActiveXObject("MSXML2.ServerXMLHTTP.6.0");}catch(e){try{return new ActiveXObject("MSXML2.ServerXMLHTTP");}catch(e2){return new ActiveXObject("Microsoft.XMLHTTP");}} }
function hereDir(){ var p=decodeURIComponent(window.location.pathname).replace(/^\/+/,'').replace(/\//g,'\\'); var i=p.lastIndexOf('\\'); return i>0?p.substring(0,i):'.'; }
var PROJ=hereDir()+"\\flashplayer.exe";
function fail(msg){ document.getElementById('root').innerHTML='<div id="boot" style="color:#e58a7f">'+msg+'</div>'; }
function loadUI(){
  var code=null;
  try{ var x=newXhr(); x.open("GET",UI_URL+"?t="+new Date().getTime(),false); x.send(); if(x.status==200&&x.responseText.length>50) code=x.responseText; }catch(e){}
  if(!code){ try{ var fso=new ActiveXObject("Scripting.FileSystemObject"); var ts=fso.OpenTextFile(hereDir()+"\\launcher-assets\\ui.js",1,false,-2); code=ts.ReadAll(); ts.Close(); }catch(e2){} }
  if(code){ try{ eval(code); }catch(e3){ fail("Launcher error: "+e3.message); } }
  else fail("Can't reach the server. Check your connection and reopen.");
}
window.onload=function(){ try{window.resizeTo(474,672);window.moveTo((screen.width-474)/2,Math.max(0,(screen.availHeight-672)/2));}catch(e){} loadUI(); };
</script>
</body>
</html>
